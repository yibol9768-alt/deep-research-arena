l":true},{"acceptable_support":{"condition_match":true,"source_ids":["prop_pairing_scope"],"source_roles":["concept"],"support_mode":"body","support_relation":"SELF"},"claim":"prop_pairing_scope","provenance_contract":"discovered_then_observed","required":true,"step_id":"E9","type":"evidence","verifier":"typed_claim","vital":true},{"acceptable_support":{"condition_match":true,"source_ids":["prop_stereo_channel_scope"],"source_roles":["concept"],"support_mode":"body","support_relation":"SELF"},"claim":"prop_stereo_channel_scope","provenance_contract":"discovered_then_observed","required":true,"step_id":"E10","type":"evidence","verifier":"typed_claim","vital":true},{"acceptable_support":{"condition_match":true,"source_ids":["prop_wired_one_side_ambiguity"],"source_roles":["community"],"support_mode":"body","support_relation":"SELF"},"claim":"prop_wired_one_side_ambiguity","provenance_contract":"discovered_then_observed","required":true,"step_id":"E11","type":"evidence","verifier":"typed_claim","vital":true},{"acceptable_support":{"condition_match":true,"source_ids":["prop_wireless_runtime_service_life"],"source_roles":["community"],"support_mode":"body","support_relation":"SELF"},"claim":"prop_wireless_runtime_service_life","provenance_contract":"discovered_then_observed","required":true,"step_id":"E12","type":"evidence","verifier":"typed_claim","vital":true},{"required":true,"requires":["E1","E2","E3","E4","E6","E8"],"rule":"battery_health_and_chemistry_boundary_v1","step_id":"B1","type":"bridge","vital":true},{"required":true,"requires":["E5","E7","E12"],"rule":"community_longevity_scope_v1","step_id":"B2","type":"bridge","vital":true},{"required":true,"requires":["E1","E2","E3","E4"],"rule":"complete_tws_listing_matrix_v1","step_id":"B3","type":"bridge","vital":true},{"required":true,"requires":["E1","E2","E3","E4","E5","E6","E7","E8","E9","E10","E11","E12"],"rule":"longevity_and_support_gate_v1","step_id":"B4","type":"bridge","vital":true},{"required":true,"requires":["E1","E9","E10","E11"],"rule":"one_side_symptom_and_service_boundary_v1","step_id":"B5","type":"bridge","vital":true},{"required":true,"requires":["E1","E2","E3","E4","E5","E6","E7","E8","E9","E10","E11","E12"],"rule":"tws_longevity_preflight_v1","step_id":"B6","type":"bridge","vital":true},{"required":true,"requires":["B1","B2","B3","B4","B5","B6"],"rule":"evidence_bounded_tws_longevity_decision_v1","step_id":"D1","type":"decision","vital":true}]},"generator_view":{"candidate_actions":["FOYCOY X10 if support, replacement compatibility, and measured retention are acceptable","renewed Plantronics BackBeat FIT 3100 if condition, battery history, support, and measured retention are acceptable","renewed Soundcore Liberty if condition, battery history, support, and measured retention are acceptable","TOZO T12 if its battery specification, support, replacement compatibility, and measured retention are acceptable","keep the current audio setup and defer while exact-model longevity and support remain unresolved"],"constraints":["all_four_complete_listing_bodies_must_be_compared","displayed_rating_and_review_count_are_snapshot_fields_not_longevity_prevalence","advertised_single_charge_and_case_hours_are_not_one_year_retention_evidence","new_and_renewed_condition_and_battery_history_must_not_be_collapsed","generic_state_of_health_does_not_supply_an_exact_model_decay_rate_or_deadline","nickel_cadmium_memory_effect_must_not_be_transferred_across_listing_chemistries","one_silent_or_low_volume_side_is_a_symptom_not_a_battery_diagnosis","community_reports_must_preserve_model_use_time_environment_and_service_scope","replacement_case_earbud_battery_firmware_return_and_warranty_routes_require_exact_model_evidence","same_condition_baseline_and_longitudinal_runtime_and_dropout_checks_are_required_for_longevity_ranking","keeping_the_current_audio_setup_and_deferring_is_an_admissible_route"],"scenario":"A buyer wants true-wireless earbuds for daily listening and calls, cares more about usable life and a recoverable one-ear failure than headline battery hours, and is comparing four fresh frozen storefront bodies. One FOYCOY X10 listing displays a 93 percent rating over 12 reviews and a 40-hour seller claim. A renewed Plantronics BackBeat FIT 3100 listing displays a 60 percent rating over 81 reviews and a 15-hour case-inclusive claim. A renewed Soundcore Liberty listing has no displayed reviews and claims 100 case-inclusive hours. A TOZO T12 listing has no displayed reviews and claims 28 case-inclusive hours. The buyer has also seen claims that small true-wireless batteries inevitably become annoying within a year or two and that a single silent earbud proves battery decay. The frozen corpus contains mixed, model-specific anecdotes, generic battery-health, memory-effect, pairing, and stereo mechanisms, and no controlled longitudinal comparison of the four listings. The buyer can keep the current audio setup and defer while exact seller, condition, support, replacement, and longitudinal evidence is checked.","target":"Determine whether the frozen listing, battery-mechanism, diagnostic, and scoped community evidence supports buying one of the four exact true-wireless listings for durable daily use and recoverable one-ear failures. Preserve each complete listing's SKU, condition, review display, seller runtime claim, and battery field; separate advertised current runtime from longitudinal retention, new from renewed battery history, a unilateral symptom from its root cause, generic battery health and nickel-cadmium memory effect from exact-model evidence, and anecdotes from prevalence. Compare support, replacement, firmware, reset, return, warranty, and same-condition longitudinal requirements, then select only a route that clears those gates or explicitly defer without inventing durability, chemistry, prevalence, compatibility, or service facts."},"graph_motif":"constraint_match_and_select","graph_node_to_step_id":{"bridge_battery_health_chemistry_boundary":"B1","bridge_community_longevity_scope":"B2","bridge_complete_tws_listing_matrix":"B3","bridge_longevity_support_gate":"B4","bridge_one_side_service_boundary":"B5","bridge_tws_longevity_preflight":"B6","decision_tws_longevity_0021":"D1","ev_foycoy_listing":"E1","ev_plantronics_listing":"E2","ev_soundcore_listing":"E3","ev_tozo_listing":"E4","prop_airpods_longevity_variability":"E5","prop_battery_soh_scope":"E6","prop_case_replacement_uncertainty":"E7","prop_memory_effect_scope":"E8","prop_pairing_scope":"E9","prop_stereo_channel_scope":"E10","prop_wired_one_side_ambiguity":"E11","prop_wireless_runtime_service_life":"E12"},"motif_compilation_schema":"graph_motif_compilation_v1","topology_checks":{"has_attributes":true,"has_constraint_relation":true,"has_decision":true,"has_multiple_options":true,"has_user_constraint":true}},"directly_scorable_gold":false,"discovery_parameters":{"max_expansion_depth":2,"per_stratum":1,"selection_seed":"24"},"graph_stamp":"evidence-graph-v1:sha256:7338bbed6a745b51cdb988bb917f12eebca0b7cdc7d57830f5d3b32d1bfdb7f6","schema":"motif_candidate_compilation_bundle_v1"}
