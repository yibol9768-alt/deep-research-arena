      "support_spans": [
        {
          "support_span_id": "span_prop_acoustic_chain",
          "exact_quote": "Acoustic quieting is the process of making machinery quieter by damping vibrations to prevent them from reaching an observer. Machinery vibrates, causing sound waves in air, hydroacoustic waves in water, and mechanical stresses in solid matter. Quieting is achieved by absorbing the vibrational energy or minimizing the source of the vibration. It may also be redirected away from an observer.",
          "occurrence": 0,
          "support_type": "body"
        },
        {
          "support_span_id": "span_prop_acoustic_sequence",
          "exact_quote": "By analyzing the entire sequence of events, from the source to the observer, an acoustic engineer can provide many ways to quieten the machine.",
          "occurrence": 0,
          "support_type": "body"
        }
