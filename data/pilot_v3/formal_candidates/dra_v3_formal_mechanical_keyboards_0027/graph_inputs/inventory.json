    {
      "evidence_id": "prop_outemu_silent_experience",
      "node_type": "proposition",
      "subject": "one Outemu silent tactile switch experience",
      "predicate": "reports_tradeoff",
      "object": "rubber dampeners, unobtrusive work use, no noticeable squish for the author, and a deeper louder result after dampener removal",
      "source_url": "http://localhost:9999/f/MechanicalKeyboards/35262/outemu-silent-cream-yellow-mini-review",
      "support_spans": [
        {
          "support_span_id": "span_prop_outemu_dampeners",
          "exact_quote": "These are tactile and come lubed, the stem is equipped with dampening rubbers, stem is of the square \"dustproof\" variety. At first I worried the dampeners would feel too squishy and one might argue that point, but for me it is not noticeable.",
          "occurrence": 0,
          "support_type": "body"
        },
        {
          "support_span_id": "span_prop_outemu_work",
          "exact_quote": "I like a thocky board like the next guy, but for work I want the keeb to be unobtrusive.",
          "occurrence": 0,
          "support_type": "body"
        },
        {
          "support_span_id": "span_prop_outemu_removal",
          "exact_quote": "One can open the switch and remove the rubber dampeners and this removes any and all feel of squishiness at the expense of it turning into a deep thoccy boy.",
          "occurrence": 0,
          "support_type": "body"
        }
      ],
      "verifier": {
        "kind": "typed_claim",
        "matcher": "normalized_text",
        "accepted_phrases": [
          "One author reports that tactile Outemu Silent Cream Yellow switches use rubber dampeners, were unobtrusive enough for work, did not feel noticeably squishy to that author, and became deeper and louder when the dampeners were removed; this is not a Cherry MX Silent Red or whole-board measurement."
        ],
        "normalizers": ["casefold", "whitespace", "punctuation", "hyphen"]
      },
      "metadata": {"acceptable_source_roles": ["community"], "critical": true, "scope": "single_person_different_switch_experience", "topic_cluster": "mechanical_keyboards"}
    },
