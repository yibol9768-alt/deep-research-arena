equires":["E3","E9","E10","E12","E14","E15"],"rule":"scoped_owner_experience_v1","step_id":"B5","type":"bridge","vital":true},{"required":true,"requires":["B1","B2","B3","B4","B5"],"rule":"matched_commuter_trial_v1","step_id":"B6","type":"bridge","vital":true},{"required":true,"requires":["B1","B2","B3","B4","B5","B6"],"rule":"evidence_bounded_oled_commute_decision_v1","step_id":"D1","type":"decision","vital":true}]},"generator_view":{"candidate_actions":["verify_the_exact_current_base_and_oled_offers_before_calculating_any_premium","compare_the_model_bound_display_storage_weight_and_battery_fields_without_inventing_performance_or_runtime","explain_what_the_lcd_and_amoled_mechanisms_and_generic_wear_material_do_and_do_not_show","keep_each_owner_statement_at_its_device_and_individual_scope","predeclare_a_noticeability_and_commute_threshold_then_trial_matched_returnable_units_under_the_same_conditions","pay_the_verified_premium_only_if_the_oled_unit_repeatably_clears_that_threshold_without_failing_commute_constraints","choose_the_cheaper_matched_configuration_or_defer_when_matching_terms_or_trial_evidence_are_missing","pay_the_verified_premium_only_if_a_matched_return_window_trial_repeatably_clears_the_buyers_display_threshold_without_failing_commute_constraints_otherwise_choose_the_cheaper_matched_configuration_or_defer"],"constraints":["treat_the_roughly_100_dollar_shop_gap_as_a_quote_to_verify_not_an_established_market_fact","do_not_compare_the_two_frozen_seller_prices_as_a_tier_premium_because_one_is_an_anomalous_oled_page_and_the_other_is_a_base_plus_game_bundle","treat_299_99_and_349_99_dollars_as_historical_launch_prices_not_current_street_prices","match_exact_sku_bundle_region_condition_storage_revision_accessories_return_terms_and_total_price","keep_display_storage_weight_and_battery_fields_attached_to_the_exact_model_and_measurement_basis","do_not_infer_gpu_performance_real_commute_runtime_or_a_quality_ranking_from_panel_type_or_table_fields","keep_lcd_amole