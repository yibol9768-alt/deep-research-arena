_low_net_carbs_keto_diabetic_friendly_and_will_not_spike_blood_sugar_instead_of_collapsing_them_into_one_claim","bind_each_claim_only_to_the_exact_sku_variant_pack_size_serving_and_wording_that_the_frozen_page_actually_shows","require_a_current_complete_ingredient_panel_nutrition_facts_serving_size_total_carbohydrate_fiber_sugar_alcohol_allulose_and_each_sweetener_amount_when_available_before_comparing_products","do_not_infer_an_unlisted_sweetener_from_brand_reputation_product_family_or_general_knowledge","do_not_treat_generic_sugar_substitute_sugar_alcohol_maltitol_stevia_or_glycemic_index_pages_as_proof_of_an_exact_products_ingredients_dose_glucose_response_digestive_tolerance_or_clinical_suitability","do_not_turn_population_average_glycemic_index_or_a_sweetener_class_mechanism_into_an_individual_post_consumption_glucose_prediction","preserve_serving_amount_total_carbohydrate_food_matrix_mixed_sweeteners_medications_insulin_resistance_and_person_to_person_variability_as_unresolved_effect_modifiers","treat_the_two_digestive_stories_as_extreme_or_confounded_individual_anecdotes_not_incidence_rates_normal_serving_trials_or_evidence_about_any_of_the_five_exact_products","treat_the_two_explainlikeimfive_threads_as_conflicting_uncontrolled_discussion_not_medical_authority_or_causal_evidence","do_not_treat_store_ratings_review_counts_delicious_classic_premium_or_taste_copy_as_independent_taste_evidence","because_the_recipient_is_newly_diagnosed_require_his_clinician_registered_dietitian_or_pharmacist_to_confirm_product_and_portion_compatibility_with_his_current_plan_before_consumption","do_not_give_diagnosis_treatment_medication_adjustment_or_a_generic_safe_intake_threshold_and_do_not_ask_the_recipient_to_self_test_in_place_of_clinical_guidance","after_clinical_eligibility_use_only_the_smallest_returnable_or_shareable_quantity_one_candidate_at_a_time_and_predeclare_taste_digestive_and_stop_rules","choose_only_an_exact_offer_whose_current_label_and_portion_are_verified_and_individually_cleared_then_select_the_lowest_total_cost_small_trial_that_passes_or_send_a_nonfood_gift_or_defer"],"scenario":"A buyer wants to send sweets to a father who was recently diagnosed with type 2 diabetes. Five frozen seller pages offer a HighKey caramel-filled bar advertised with zero-sugar, no-added-sugar, zero-carb, diabetic-friendly, and no-blood-sugar-spike language; a Lily's crispy-rice dark bar advertised as stevia-sweetened and no-added-sugar; ChocZero dark peanut-butter cups advertised as monk-fruit-sweetened with no sugar alcohols; HERSHEY'S SPECIAL DARK candy advertised as zero-sugar and aspartame-free; and Russell Stover dark candy advertised as sugar-free and made with stevia. The research set also contains generic pages about sugar substitutes, sugar alcohols, maltitol, stevia, and glycemic index, plus four community discussions. It does not contain complete current ingredient and nutrition panels for all five offers, exact sweetener grams per serving, tested glycemic responses for these exact products, the father's medications or treatment plan, or an individualized clinician determination.","target":"Audit what each frozen seller, concept, and community source can and cannot establish about five exact sugar-free or no-added-sugar sweets for a newly diagnosed recipient. Build an exact-offer claim and missing-field matrix; keep the marketing phrases non-equivalent; bind sweetener identity, mixture, amount, serving, and food matrix before comparing; explain why generic mechanisms and population-average glycemic evidence cannot predict an individual outcome; scope digestive anecdotes and ratings correctly; and require recipient permission plus clinician, registered-dietitian, or pharmacist compatibility review before consumption. Only after that gate, design the smallest one-product-at-a-time taste trial and choose the lowest-total-cost eligible option, a nonfood gift, or deferral without diagnosis, prescribing, medication adjustment, a universal safe dose, or a zero-impact promise."},"graph_motif":"multi_branch_synthesis","graph_node_to_step_id":{"bridge_clinician_first_new_diagnosis_gate":"B7","bridge_digestive_and_community_scope":"B1","bridge_exact_offer_claim_disclosure_matrix":"B2","bridge_glycemic_and_individual_response_boundary":"B6","bridge_marketing_claim_non_equivalence":"B3","bridge_sweetener_identity_and_dose_binding":"B4","bridge_taste_evidence_and_small_trial_boundary":"B5","decision_evidence_bounded_sugar_free_gift":"D1","prop_choczero_offer_monk_fruit_no_polyol_claim":"E1","prop_friends_diarrhea_confounded_anecdote_scope":"E2","prop_fruit_processed_sugar_conflicting_discussion_scope":"E3","prop_glycemic_index_population_and_variability_boundary":"E4","prop_hershey_offer_zero_sugar_aspartame_free_claim":"E5","prop_highkey_offer_and_no_spike_claim":"E6","prop_lilys_offer_stevia_no_added_sugar_claim":"E7","prop_maltitol_specific_metabolic_and_digestive_scope":"E8","prop_russell_stover_offer_stevia_sugar_free_claim":"E9","prop_stevia_extract_taste_and_regulatory_scope":"E10","prop_sugar_alcohol_absorption_and_tolerance_scope":"E11","prop_sugar_free_drinks_conflicting_discussion_scope":"E12","prop_sugar_substitute_category_and_outcome_uncertainty":"E13","prop_werther_extreme_intake_anecdote_scope":"E14"},"motif_compilation_schema":"graph_motif_compilation_v1","topology_checks":{"has_multiple_independent_branches":true,"has_synthesized_decision":true}},"directly_scorable_gold":false,"discovery_parameters":{"max_expansion_depth":4,"per_stratum":5,"selection_seed":"45"},"graph_stamp":"evidence-graph-v1:sha256:394f3a10c7a5a3003e151c4d800f45b3a5757db8d54355e05b144e33d3a5455b","schema":"motif_candidate_compilation_bundle_v1"}
