eversible one-variable trial after ingredient, dose, allergy, interaction, and symptom-safety checks. End with a conditional claim-neutral choice or defer, do not name a universal wellness winner, and direct persistent, severe, or diagnostic symptoms to qualified medical care rather than beverage self-treatment."},"graph_motif":"multi_branch_synthesis","graph_node_to_step_id":{"bridge_antioxidant_activity_outcome":"B1","bridge_caffeine_dose_person":"B2","bridge_community_scope":"B3","bridge_fungal_drug_product_scope":"B4","bridge_low_acid_measurement_symptom":"B5","bridge_named_detox_endpoint":"B6","bridge_seller_claim_status":"B7","decision_evidence_bounded_wellness_claim_choice":"D1","prop_antioxidant_outcome_boundary":"E1","prop_black_tea_anxiety_anecdote_scope":"E2","prop_caffeine_response_boundary":"E3","prop_detox_concept_boundary":"E4","prop_energy_kick_question_scope":"E5","prop_la_republica_mushroom_claim_snapshot":"E6","prop_lakanto_matcha_claim_snapshot":"E7","prop_lifeboost_low_acid_claim_snapshot":"E8","prop_low_acid_measurement_boundary":"E9","prop_medicinal_fungi_supplement_boundary":"E10","prop_starbucks_sleep_anecdote_scope":"E11","prop_tea_caffeine_question_scope":"E12","prop_tealyra_blood_cleanser_claim_snapshot":"E13"},"motif_compilation_schema":"graph_motif_compilation_v1","topology_checks":{"has_multiple_independent_branches":true,"has_synthesized_decision":true}},"directly_scorable_gold":false,"discovery_parameters":{"max_expansion_depth":3,"per_stratum":1,"selection_seed":"39"},"graph_stamp":"evidence-graph-v1:sha256:e127a5d2078b0eb4d533169a9034bb969f3cb56f30cffecaa51abf1f31b27525","schema":"motif_candidate_compilation_bundle_v1"}
