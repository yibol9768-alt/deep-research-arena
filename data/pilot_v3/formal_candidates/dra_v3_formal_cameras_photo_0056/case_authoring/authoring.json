              "normalizers": [
                "casefold",
                "whitespace",
                "punctuation",
                "hyphen"
              ]
            },
            "gates_are_predeclared": {
              "matcher": "normalized_text",
              "accepted_phrases": [
                "Predeclare meaningful-improvement, compatibility, condition, workflow, output and total-cost gates and mark each pass, fail or unresolved before unblinding."
