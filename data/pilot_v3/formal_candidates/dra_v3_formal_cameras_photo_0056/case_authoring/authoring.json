                "casefold",
                "whitespace",
                "punctuation",
                "hyphen"
              ]
            },
            "community_images_are_scoped": {
              "matcher": "normalized_text",
              "accepted_phrases": [
                "Keep the Andromeda, macro and moon images tied to their author, camera, lens, subject, distance, tracker, stack, processing, crop, output and missing metadata."
