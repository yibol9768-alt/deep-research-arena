  "rule_definitions": {
    "community_image_workflow_scope_v1": {
      "type": "bridge",
      "matcher": "normalized_text",
      "accepted_phrases": [
        "Keep each community image scoped to its camera, lens, subject, environment, exposure, tracker, stacking, processing, crop and output, and treat missing metadata as unresolved rather than lens evidence."
      ],
      "normalizers": [
        "casefold",
        "whitespace",
        "punctuation",
        "hyphen"
      ]
    },
    "mount_focal_task_scope_v1": {
      "type": "bridge",
      "matcher": "normalized_text",
      "accepted_phrases": [
        "Bind EF or EF-S mount, sensor format, focal length, crop field of view, aperture, autofocus and stabilization to the actual 4000D body and intended scene rather than ranking unmatched lenses by one specification."
      ],
      "normalizers": [
        "casefold",
        "whitespace",
        "punctuation",
        "hyphen"
      ]
    },
    "optical_design_mechanism_scope_v1": {
      "type": "bridge",
      "matcher": "normalized_text",
      "accepted_phrases": [
        "Explain coating, photographic design, chromatic aberration and spherical aberration as mechanisms and tradeoffs that require exact-lens tests rather than premium-label or price conclusions."
      ],
      "normalizers": [
        "casefold",
        "whitespace",
        "punctuation",
        "hyphen"
      ]
    },
    "seller_lens_offer_scope_v1": {
      "type": "bridge",
      "matcher": "normalized_text",
      "accepted_phrases": [
        "Audit the six exact frozen seller pages and keep price, rating, review count, condition, bundle, warranty and performance language bound to its exact page without turning marketing or category labels into controlled optical results."
      ],
      "normalizers": [
        "casefold",
        "whitespace",
        "punctuation",
        "hyphen"
      ]
    },
    "output_artifact_measurement_scope_v1": {
      "type": "bridge",
      "matcher": "normalized_text",
      "accepted_phrases": [
        "Measure vignetting, flare, scale-dependent contrast transfer and diffraction under declared aperture, focus, frame position, lighting, processing and final web or print output conditions."
      ],
      "normalizers": [
        "casefold",
        "whitespace",
        "punctuation",
        "hyphen"
      ]
    },
    "matched_lens_trial_v1": {
      "type": "bridge",
      "matcher": "normalized_text",
      "accepted_phrases": [
        "Verify exact identity, condition and compatibility, then run a reversible same-body task-matched and output-normalized trial with separate focus, keeper, artifact, workflow and preference measurements."
      ],
      "normalizers": [
        "casefold",
        "whitespace",
        "punctuation",
        "hyphen"
      ]
    },
    "lens_value_decision_preparation_v1": {
      "type": "bridge",
      "matcher": "normalized_text",
      "accepted_phrases": [
        "Predeclare meaningful-improvement, compatibility, condition, workflow, intended-output and total-cost gates so price, rating, aperture, one crop or one community image cannot compensate for a failed hard gate."
      ],
      "normalizers": [
        "casefold",
        "whitespace",
        "punctuation",
        "hyphen"
      ]
    },
    "evidence_bounded_lens_purchase_decision_v1": {
      "type": "decision",
      "decision_matcher": {
        "matcher": "normalized_text",
        "accepted_phrases": [
          "Choose only the lowest-total-cost exact lens that passes every gate and meaningfully improves the declared outputs over the actual kit baseline; otherwise keep the kit, rent for a special task, save for another need, rerun a corrected trial or defer."
        ],
        "normalizers": [
          "casefold",
          "whitespace",
          "punctuation",
          "hyphen"
        ]
      },
      "conclusion_matchers": {
        "verify_exact_candidates_run_an_output_normalized_task_matched_trial_and_choose_the_lowest_total_cost_passing_lens_only_if_it_meaningfully_beats_the_kit_otherwise_keep_rent_save_rerun_or_defer": {
          "matcher": "normalized_text",
          "accepted_phrases": [
            "The packet proves no universal lens-value cutoff. Verify exact candidates, run a same-body task-matched and output-normalized trial, and choose only the lowest-total-cost exact lens that passes every gate and meaningfully improves the declared outputs over the actual kit; otherwise keep the kit, rent, save, rerun or defer.",
            "Select the lowest-cost exact passing lens only after a controlled comparison shows a meaningful benefit over the kit baseline, or use a reversible fallback."
          ],
          "normalizers": [
            "casefold",
            "whitespace",
            "punctuation",
            "hyphen"
          ]
        }
      },
      "admissible_conditions": [
        {
          "answer": "verify_exact_candidates_run_an_output_normalized_task_matched_trial_and_choose_the_lowest_total_cost_passing_lens_only_if_it_meaningfully_beats_the_kit_otherwise_keep_rent_save_rerun_or_defer",
