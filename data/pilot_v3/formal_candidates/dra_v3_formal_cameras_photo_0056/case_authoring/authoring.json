                "casefold",
                "whitespace",
                "punctuation",
                "hyphen"
              ]
            },
            "prime_zoom_labels_are_tendencies": {
              "matcher": "normalized_text",
              "accepted_phrases": [
                "Prime and zoom category tendencies do not establish that one exact prime is sharper, lighter or better for every declared task."
