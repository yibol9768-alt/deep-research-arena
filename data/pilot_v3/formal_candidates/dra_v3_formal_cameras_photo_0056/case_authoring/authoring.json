            "result_scope_is_local": {
              "matcher": "normalized_text",
              "accepted_phrases": [
                "Scope any result to the tested body, lens samples, tasks, settings, processing and web or small-print outputs rather than a universal price-to-quality rule."
              ],
              "normalizers": [
                "casefold",
                "whitespace",
                "punctuation",
                "hyphen"
              ]
            }
          }
        }
      ]
    }
