actions":["audit_the_four_exact_offer_snapshots_and_resolve_missing_or_conflicting_fields","explain_decaffeination_residual_caffeine_process_and_flavor_without_treating_marketing_as_measurement","compare_hojicha_white_tea_and_herbal_category_boundaries_without_inventing_exact_exposure","scope_the_community_pages_to_preparation_sensory_proxy_and_small_sample_trial_design","build_a_verified_product_specific_caffeine_and_ingredient_ledger_against_the_clinicians_instruction_before_consumption","run_a_small_fixed_recipe_blinded_multi_day_ritual_trial_only_for_candidates_that_pass_the_safety_gate","order_only_a_verified_clinician_limit_compatible_candidate_then_rebuy_if_the_fixed_ritual_trial_passes_or_defer"],"constraints":["follow_the_users_individualized_clinician_instruction_and_do_not_replace_it_with_a_generic_caffeine_threshold","do_not_diagnose_prescribe_a_taper_treat_symptoms_or_claim_any_product_is_medically_safe","compare_only_the_four_exact_frozen_skus_prices_package_fields_ratings_formats_and_seller_labels","treat_process_percentage_low_caffeine_decaffeinated_flavor_freshness_and_suitability_language_as_seller_claims_until_exact_product_data_support_it","surface_the_seattles_best_12_ounce_versus_10_4_ounce_page_discrepancy","explain_that_decaffeination_is_reduction_not_zero_and_keep_residual_caffeine_separate_from_process_and_flavor","do_not_name_a_universally_best_tasting_decaffeination_method","do_not_infer_exact_caffeine_from_hojicha_white_tea_herbal_light_mild_color_or_bitterness_labels","check_exact_herbal_ingredients_and_relevant_interactions_with_the_users_clinician_or_pharmacist","keep_each_community_statement_scoped_to_its_author_and_use_it_only_for_trial_design_not_medical_evidence","require_verified_product_specific_caffeine_serving_and_preparation_data_that_fit_the_clinicians_instruction_before_consumption","stop_and_contact_the_clinician_if_symptoms_occur_or_the_instruction_product_exposure_or_interactions_are_unclear","after_the_safety_gate_use_small_quantities_fixed_recipes_blinding_repeats_and_a_caffeine_ledger","rebuy_only_a_verified_clinician_limit_compatible_exact_candidate_that_repeatedly_passes_taste_ritual_cost_and_waste_thresholds_or_defer"],"scenario":"A user has been told by their doctor to cut caffeine way back but wants to preserve a satisfying morning-coffee and afternoon-tea ritual and dislikes watery decaf. Four frozen offers are in scope: a 17.49-dollar 12-ounce whole-bean Merry Mocha Mint product titled SWP Decaf whose seller page claims Swiss Water processing and 99.9-percent caffeine-free flavor protection; a 6.99-dollar Seattle's Best Decaf Portside ground-coffee offer with a 78-percent-of-100 aggregate over twelve reviews whose title says 12 ounces but whose product-dimensions line says 10.4 ounces; a 27-dollar 100-gram Ocha & Co. hojicha powder seller-labeled low caffeine with a sweet smoky taste; and a 22.96-dollar six-pack of 18-bag Good Earth decaffeinated lemongrass green tea with a 92-percent-of-100 aggregate over twelve reviews. None supplies independently verified caffeine milligrams for the exact prepared serving. General material covers decaffeination residuals and flavor-preservation goals, hojicha roasting, white-tea variability, and herbal-infusion ingredient boundaries. Three community discussions cover a large brew-ratio change, color and bitterness as possible caffeine proxies, and small-quantity tea sampling.","target":"Help the user preserve a morning-coffee and afternoon-tea ritual without overruling the doctor's individualized instruction. Audit the four exact offers, distinguish decaffeination residual caffeine from method and flavor, compare the tea-category boundaries, and use the community material only at anecdote or trial-design scale. Before any consumption, require verified exact-serving caffeine and ingredient data that fit the clinician's instruction. Then, only for eligible candidates, design a small fixed-recipe blinded repeated taste-and-ritual trial and finish with a conditional exact-product order and rebuy or deferral, never diagnosis, a generic safe dose, tapering, treatment, or a universal product winner."},"graph_motif":"multi_branch_synthesis","graph_node_to_step_id":{"bridge_clinician_limit_first_safety_gate":"B5","bridge_decaf_low_caffeine_offer_disclosure_matrix":"B1","bridge_decaffeination_residual_and_flavor_boundary":"B2","bridge_reversible_ritual_preserving_trial":"B6","bridge_scoped_ritual_and_preparation_transfer":"B3","bridge_tea_category_caffeine_uncertainty":"B4","decision_evidence_bounded_decaf_low_caffeine_order":"D1","prop_community_brew_change_anecdote_scope":"E1","prop_community_sensory_proxy_question_scope":"E2","prop_community_small_sample_tea_scope":"E3","prop_decaffeination_residual_process_scope":"E4","prop_good_earth_decaf_tea_offer_snapshot":"E5","prop_herbal_tea_caffeine_ingredient_scope":"E6","prop_hojicha_general_roast_flavor_caffeine_scope":"E7","prop_merry_swp_decaf_offer_snapshot":"E8","prop_ocha_hojicha_offer_snapshot":"E9","prop_seattles_best_decaf_offer_snapshot":"E10","prop_white_tea_caffeine_variability_scope":"E11"},"motif_compilation_schema":"graph_motif_compilation_v1","topology_checks":{"has_multiple_independent_branches":true,"has_synthesized_decision":true}},"directly_scorable_gold":false,"discovery_parameters":{"max_expansion_depth":4,"per_stratum":5,"selection_seed":"43"},"graph_stamp":"evidence-graph-v1:sha256:750596ea846df986e1c638d35e5ec2b745c8a7f93fe2be93191d195f2a5f6e50","schema":"motif_candidate_compilation_bundle_v1"}
