  "_methodology": {
    "attribution": "Per-run token attribution by time-window matching. Each subset run in subset_results.tsv defines a window [started_at, ended_at] (ISO-8601 with -06:00 offset, converted to epoch). Each gateway usage record in /root/llmgw_usage_dsflash.jsonl (one JSON line per LLM call: model, prompt_tokens, completion_tokens, ts=unix epoch) is matched to runs whose backbone equals the record's `model` field AND whose window contains the record ts.",
    "disambiguation": "Records are first split by backbone via the `model` field: a qwen3-8b call can only belong to a qwen3-8b lane, a deepseek-v4-flash call only to a dsflash lane. Within a backbone, if a record falls inside exactly one run window it is uniquely attributed (full weight). If it falls inside k>1 concurrent same-backbone windows it is AMBIGUOUS: its tokens are split 1/k across the candidate runs and counted toward ambiguous_fraction. Records outside every subset window (smoke tests, warmup, judging, idle) are left unattributed.",
    "ambiguous_fraction": "Per (framework,backbone): fraction of that cell's attributed token mass that came from ambiguous (k>1) records. Low values mean the lane ran effectively sequentially.",
    "overlap_pairs_same_backbone": 0,
    "records": {
      "usage_records_total": 14166,
      "usage_records_attributed": 6923,
      "usage_records_ambiguous": 0,
      "usage_records_unattributed": 7243,
      "mark_records_skipped": 64,
      "malformed_lines_skipped": 0,
      "model_field_distribution": {
        "qwen3-8b": 6942,
        "deepseek-v4-flash": 7218,
        "deepseek-v4": 2,
        "deepseek-v4-pro": 1,
        "glm-4.7-flash": 3
      }
    },
    "tokens": {
      "total_usage_tokens": 225509939,
      "attributed_tokens": 109292894,
      "unattributed_prompt_tokens": 113550657,
      "unattributed_completion_tokens": 2666388,
      "note": "Unattributed tokens are gateway calls outside all subset run windows: pre-run smoke tests, warmups, and (mostly) the LLM-judge jury passes that ran after the agent runs. They are correctly excluded from per-framework agent cost."
    },
    "pricing": {
      "deepseek-v4-flash": "CONFIRMED ¥1/M prompt, ¥2/M completion (DashScope/Bailian list price).",
      "qwen3-8b": "ESTIMATE ¥0.5/M prompt, ¥1.5/M completion. qwen3-8b was run LOCALLY on the 5090 box, so NO API cost was actually incurred; this price is a Bailian-tier approximation used only to make the two backbones comparable on the same axis. Flagged confirmed=false. Treat qwen3-8b cost as opportunity-cost/comparability, not a billed amount.",
      "judges_excluded": "glm-4.7 / MiniMax-M2.5 / deepseek-v4-flash judge (jury) calls are NOT part of per-framework agent cost and fall outside run windows; the glm judge proxy (port 8092) is not in this gateway log at all (no_data for judge cost here)."
    },
    "limitations": [
      "Token counts are the gateway's reported prompt/completion tokens; runs whose backbone bypassed the gateway would show zero (none observed: both backbones route through the gateway).",
      "fail/timeout runs are kept (they still consumed tokens); n_runs_pass is reported alongside n_runs_in_tsv.",
      "llm_calls_delta_sum (harness-reported call count per run) is included per cell as an independent cross-check against records_attributed.",
      "Cost is inference token cost only; no infra/GPU amortization."
    ]
  }
