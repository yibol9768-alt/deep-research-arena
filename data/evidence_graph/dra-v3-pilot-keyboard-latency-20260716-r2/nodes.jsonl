{"body_support":true,"content_sha256":"cb920b09d382460a6484c860398a04bf965da2f7406a8aa706a3147bf8998aa0","corpus_snapshot":"dra-v3-pilot-keyboard-latency-my5090-20260716-r2","evidence_id":"assert_optical_debounce_mechanisms","metadata":{"topic_cluster":"keyboard_latency_claims"},"node_type":"assertion","object":"Optical keyboards use light emitters and photo sensors without physical sensing contact, while keyboard processors debounce oscillating contacts to confirm one keystroke.","predicate":"states","search_snippet_support":false,"source_type":"wikipedia","source_url":"http://localhost:8090/content/wikipedia_en_all_nopic/Keyboard_technology","subject":"Keyboard technology article","verifier":{"kind":"quoted_assertion"}}
