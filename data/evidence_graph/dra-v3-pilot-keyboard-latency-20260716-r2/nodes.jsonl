{"body_support":true,"content_sha256":"785b67fcb4506964f5e069b9aeeb272dd413a786cd8283280e42eb69399f5f63","corpus_snapshot":"dra-v3-pilot-keyboard-latency-my5090-20260716-r2","evidence_id":"assert_hertz_definition","metadata":{"topic_cluster":"keyboard_latency_claims"},"node_type":"assertion","object":"Hertz is one periodic event per second.","predicate":"states","search_snippet_support":false,"source_type":"wikipedia","source_url":"http://localhost:8090/content/wikipedia_en_all_nopic/Hertz","subject":"Hertz article","verifier":{"kind":"quoted_assertion"}}
{"body_support":true,"content_sha256":"785b67fcb4506964f5e069b9aeeb272dd413a786cd8283280e42eb69399f5f63","corpus_snapshot":"dra-v3-pilot-keyboard-latency-my5090-20260716-r2","evidence_id":"prop_hertz_period_scope","metadata":{"acceptable_source_roles":["concept"],"calculation":"1/8000 s = 0.125 ms; 1/1000 s = 1 ms; difference = 0.875 ms","critical":true,"topic_cluster":"keyboard_latency_claims"},"node_type":"proposition","object":"Hertz means events per second. If a device actually polls at 8000 Hz, one poll period is 0.125 ms; at 1000 Hz it is 1 ms. The 0.875 ms period difference is arithmetic only and does not equal a measured end-to-end latency or perception threshold.","predicate":"has_reciprocal_period_not_total_latency","search_snippet_support":false,"source_type":"wikipedia","source_url":"http://localhost:8090/content/wikipedia_en_all_nopic/Hertz","subject":"hypothetical polling frequency","verifier":{"accepted_phrases":["Because hertz means events per second, hypothetical 8000 Hz and 1000 Hz poll periods are 0.125 ms and 1 ms; their 0.875 ms difference is not by itself an end-to-end latency or perceptibility result."],"kind":"typed_claim","matcher":"normalized_text","normalizers":["casefold","whitespace","punctuation","hyphen"]}}
{"body_support":true,"content_sha256":"7bf518cb8003d127f59a44ecea91de4ac90412920101f9130a0a406495dd88cd","corpus_snapshot":"dra-v3-pilot-keyboard-latency-my5090-20260716-r2","evidence_id":"assert_polling_definition","metadata":{"topic_cluster":"keyboard_latency_claims"},"node_type":"assertion","object":"Polling actively samples external-device status, and a polling cycle trades response speed against processor or bandwidth overhead.","predicate":"states","search_snippet_support":false,"source_type":"wikipedia","source_url":"http://localhost:8090/content/wikipedia_en_all_nopic/Polling_(computer_science)","subject":"Polling article","verifier":{"kind":"quoted_assertion"}}
{"body_support":true,"content_sha256":"7bf518cb8003d127f59a44ecea91de4ac90412920101f9130a0a406495dd88cd","corpus_snapshot":"dra-v3-pilot-keyboard-latency-my5090-20260716-r2","evidence_id":"prop_polling_scope","metadata":{"acceptable_source_roles":["concept"],"critical":true,"topic_cluster":"keyboard_latency_claims"},"node_type":"proposition","object":"Polling actively samples an external device, and a polling cycle is the time to monitor each element once. The desired response speed and processing or bandwidth overhead affect the appropriate cycle; this generic definition does not specify either keyboard's polling rate.","predicate":"repeatedly_samples_with_cycle_tradeoffs","search_snippet_support":false,"source_type":"wikipedia","source_url":"http://localhost:8090/content/wikipedia_en_all_nopic/Polling_(computer_science)","subject":"computer polling","verifier":{"accepted_phrases":["Polling is repeated status sampling with a cycle-time and overhead tradeoff; the generic definition does not establish a polling rate for either frozen keyboard."],"kind":"typed_claim","matcher":"normalized_text","normalizers":["casefold","whitespace","punctuation","hyphen"]}}
