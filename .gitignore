# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.coverage
.tox/
.venv/
venv/
env/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Heavy / external (clone separately) ---
third_party/
paper_dr_lab/
paper_survey/
webarena_ref/

# --- Per-run scratch ---
*.tmp
/tmp/
.auth/
**/scratch/

# --- Backup / pre-migration snapshots (do not commit) ---
*.bak
**/*.preV1*
**/*.preFix*
**/*.cwbak.json

# --- Unpublished paper drafts (kept out of the public repo) ---
paper_iclr/

# --- LaTeX intermediates (regenerated on build) ---
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper_deep/*.aux
paper_deep/*.log
paper_deep/*.out
paper_deep/*.toc

# Keep curated *.md leaderboards under data/results/, drop raw dumps
data/results/*.json
data/results/*.answer.txt
data/results/q_*

# ...but keep the analysis JSONs that drive paper tables
!data/results/length_ablation.json
!data/results/error_taxonomy.json
!data/results/irt_calibration.json
!data/results/arena_elo_ED.json
!data/results/arena_final.json
!data/results/arena_ablation_no_fkg_chk.json
!data/results/source_diversity.json

# --- LaTeX build artefacts ---
latex/build/
latex/findings.pdf
latex/tables/*.tex
!latex/tables/.gitkeep

# --- Auth / secrets ---
*.env
.env
.env.*
!.env.example
secrets.yaml
*.pem
*.key

# --- Playwright cache ---
.playwright/
playwright-report/
ms-playwright/
integrations/deerflow/conf.yaml
.env

# --- Node / Next.js (frontend) ---
# keep web/dist/ tracked (Cloudflare deploy artifact) per claude.md
node_modules/
.next/
frontend/out/
frontend/tsconfig.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# --- Git worktrees (transient parallel-dispatch checkouts) ---
# Live at <project>/worktrees/wt-<name>/. Branches stay in .git so removal
# is safe; the directories themselves should never be committed.
worktrees/

# Runtime shim/eval logs
logs/

# box scratch dir (may contain .env secrets) - never commit
.dra_tmp/
