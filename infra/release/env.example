# Copy to .env before starting the bundle.

# Required only for proxied LLM calls through http://localhost:8081/llm/v1.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DASHSCOPE_API_KEY=

# Host ports.
SHOPPING_PORT=7770
REDDIT_PORT=9999
WIKI_PORT=8090
GATEWAY_PORT=8081

# The bundled full wiki snapshot is the default.
WIKI_ZIM_FILE=wikipedia_en_all_nopic.zim
WIKI_KIWIX_BOOK=wikipedia_en_all_nopic

# If exposing the shopping site from a remote host, set this to the public URL.
# Example: SHOPPING_BASE_URL=http://203.0.113.10:7770/
SHOPPING_BASE_URL=http://localhost:7770/

