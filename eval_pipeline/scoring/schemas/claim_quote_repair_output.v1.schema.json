{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "truth1000://biodiv/claim-quote-repair-output/v1",
  "type": "object",
  "properties": {
    "repairs": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "claim_index": {"type": "integer", "minimum": 0, "maximum": 255},
          "exact_report_quote": {"type": "string", "minLength": 1, "maxLength": 4000}
        },
        "required": ["claim_index", "exact_report_quote"],
        "additionalProperties": false
      }
    }
  },
  "required": ["repairs"],
  "additionalProperties": false
}
